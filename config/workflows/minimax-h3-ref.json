{
  "127": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "底模（参考图专用 ref2va）" }
  },
  "128": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" },
    "_meta": { "title": "文本编码器" }
  },
  "119": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
    "_meta": { "title": "视频VAE" }
  },
  "120": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "音频VAE" }
  },
  "137": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png", "upload": "image" },
    "_meta": { "title": "参考图（由插件自动填入，想加多张就再连 ref_image_1）" }
  },
  "136": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["128", 0],
      "vae": ["119", 0],
      "audio_vae": ["120", 0],
      "prompt": "保持参考图的人物与风格，镜头缓缓推近，电影感光影",
      "width": 832,
      "height": 480,
      "length": 56,
      "ref_image_size": "match",
      "ref_images": { "ref_image_0": ["137", 0] }
    },
    "_meta": { "title": "提示词 / 尺寸 / 帧数 / 参考图（提示词在这里）" }
  },
  "129": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 1 },
    "_meta": { "title": "噪声种子" }
  },
  "123": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" },
    "_meta": { "title": "采样器" }
  },
  "124": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["127", 0], "scheduler": "simple", "steps": 20, "denoise": 1 },
    "_meta": { "title": "调度器（步数在这里）" }
  },
  "126": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["127", 0], "conditioning": ["136", 0] },
    "_meta": { "title": "引导" }
  },
  "125": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["129", 0],
      "guider": ["126", 0],
      "sampler": ["123", 0],
      "sigmas": ["124", 0],
      "latent_image": ["136", 1]
    },
    "_meta": { "title": "采样" }
  },
  "122": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["125", 0], "vae": ["119", 0] },
    "_meta": { "title": "解码画面" }
  },
  "121": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["125", 0], "vae": ["120", 0] },
    "_meta": { "title": "解码音频" }
  },
  "130": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["122", 0], "audio": ["121", 0], "fps": 24, "bit_depth": 8 },
    "_meta": { "title": "合成视频（带音频）" }
  },
  "92": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["130", 0], "filename_prefix": "video/MiniMax_H3", "format": "auto", "codec": "auto" },
    "_meta": { "title": "保存视频" }
  }
}
